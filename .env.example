# API-Football (optional external football data)
API_FOOTBALL_KEY=

# Personal cross-browser profile sync (Upstash Redis / Vercel KV REST)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Supported Upstash aliases (use either this pair or the KV pair above)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
FPL_APP_PASSWORD=
FPL_SESSION_SECRET=

# Telegram squad-alert digest (/api/notify, daily cron)
# Bot token from BotFather; chat id of the chat to deliver to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which FPL squad to analyse for the digest (public picks must be available).
FPL_ENTRY_ID=
# Optional: a mini-league id to include standings/gap in the digest.
FPL_LEAGUE_ID=
# Optional: protect the /api/notify and /api/notify/urgent endpoints.
# The urgent tier is triggered every ~30 min by .github/workflows/urgent-alerts.yml,
# which needs two GitHub repo secrets: APP_URL (your deployed URL) and CRON_SECRET
# (same value as here). Urgent dedup reuses the KV/Upstash vars above.
CRON_SECRET=
