# API-Football (optional external football data)
API_FOOTBALL_KEY=

# Personal cross-browser profile sync (Upstash Redis / Vercel KV REST)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Supported Upstash aliases (use either this pair or the KV pair above)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
FPL_APP_PASSWORD=
FPL_SESSION_SECRET=

# Telegram squad-alert digest (/api/notify, daily cron)
# Bot token from BotFather; chat id of the chat to deliver to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which FPL squad to analyse for the digest (public picks must be available).
FPL_ENTRY_ID=
# Optional: protect the /api/notify cron endpoint from public calls.
CRON_SECRET=
