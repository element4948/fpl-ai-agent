# API-Football (optional external football data)
API_FOOTBALL_KEY=

# Personal cross-browser profile sync (Upstash Redis / Vercel KV REST)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Supported Upstash aliases (use either this pair or the KV pair above)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
FPL_APP_PASSWORD=
FPL_SESSION_SECRET=

# Telegram squad-alert digest (/api/notify, daily at 17:00 Asia/Ulaanbaatar)
# Bot token from BotFather; chat id of the chat to deliver to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which FPL squad to analyse for the digest (public picks must be available).
FPL_ENTRY_ID=
# Optional: a mini-league id to include standings/gap in the digest.
FPL_LEAGUE_ID=
# Protect the cron endpoints. Vercel sends this value as a Bearer token for cron.
# The urgent endpoint exists but is not scheduled by default; add a monitored
# schedule only after confirming provider limits and alert volume.
CRON_SECRET=
